# .env — Local development configuration
# Generated automatically for localhost deployment

# ── Twitter/X API ─────────────────────────────────────────────
# Not required for mock mode
TWITTER_BEARER_TOKEN=

# ── Copernicus / ESA Sentinel-1 ───────────────────────────────
# Not required for mock SAR mode
COPERNICUS_USER=
COPERNICUS_PASS=

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Database (PostGIS) ────────────────────────────────────────
DATABASE_URL=postgresql://disaster:disaster123@localhost:5432/disaster_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Model ─────────────────────────────────────────────────────
MODEL_PATH=checkpoints/best_model.pt
INFERENCE_DEVICE=cpu

# ── Spark Streaming ──────────────────────────────────────────
SPARK_LOCAL_MODE=true
SPARK_CHECKPOINT_DIR=/tmp/spark_checkpoints
SPARK_SHUFFLE_PARTITIONS=8
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g

# ── Tweet Preprocessing Thresholds ────────────────────────────
MIN_TWEET_CREDIBILITY=0.30
MAX_BOT_SCORE=0.70

# ── Pipeline Mode ─────────────────────────────────────────────
STREAMING_MODE=tweet_only
SOCIAL_SOURCE=mock

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
