# .env.example — Copy to .env and fill in your credentials

# ── Twitter/X API ─────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ── Copernicus / ESA Sentinel-1 ───────────────────────────────
# Register free at: https://scihub.copernicus.eu/dhus/#/self-registration
COPERNICUS_USER=your_username
COPERNICUS_PASS=your_password

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Database (PostGIS) ────────────────────────────────────────
DATABASE_URL=postgresql://disaster:disaster123@localhost:5432/disaster_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Model ─────────────────────────────────────────────────────
MODEL_PATH=checkpoints/best_model.pt
INFERENCE_DEVICE=cpu
# Set to 'cuda' if GPU is available

# ── Spark Streaming ──────────────────────────────────────────
# Set to false when using a real Spark cluster (docker-compose spark-master)
SPARK_LOCAL_MODE=true
SPARK_CHECKPOINT_DIR=/tmp/spark_checkpoints
SPARK_SHUFFLE_PARTITIONS=8
SPARK_EXECUTOR_MEMORY=4g
SPARK_DRIVER_MEMORY=2g
# Kafka internal address (for Spark inside Docker; use localhost:9092 for host)
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── Tweet Preprocessing Thresholds ────────────────────────────
MIN_TWEET_CREDIBILITY=0.30
MAX_BOT_SCORE=0.70

# ── Pipeline Mode ─────────────────────────────────────────────
# tweet_only: tweets-only inference (no SAR join) — works without real SAR data
# fusion:     SAR + tweets stream-stream join + fusion model
STREAMING_MODE=tweet_only
# Social media source: mock | bluesky | mastodon | twitter
SOCIAL_SOURCE=mock

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
